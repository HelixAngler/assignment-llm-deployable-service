# Template konfigurasi — salin ke .env lalu isi nilai sebenarnya:
#   cp .env.example .env
# File .env TIDAK di-commit (ada di .gitignore); file ini aman di-commit.

# Wajib: API key Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Model untuk generasi jawaban & intent detection (runtime)
GEMINI_MODEL=gemini-3.6-flash

# Model embedding (runtime untuk query embedding; build time via --build-arg)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Path file (default aplikasi — sesuaikan bila struktur berbeda)
EMBEDDINGS_BASE_PATH=embed/embedding.bin
KNOWLEDGE_BASE_PATH=data/it_helpdesk_knowledge_base.csv
PREPROCESS_KNOWLEDGE_BASE_PATH=embed/preprocess_knowledge.parquet
